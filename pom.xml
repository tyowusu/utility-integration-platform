<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>
    <!--
      Anypoint Exchange requires a published asset's groupId to be the
      organisation UUID; anything else is rejected outright at publish time.
      Since CloudHub 2.0 deploys *from* Exchange rather than from an uploaded
      jar, this is not optional for a deployed application.

      The cost is that this coordinate is organisation-specific: a fork
      publishing to a different Anypoint org must change it, along with the
      anypoint.orgId passed at build time.
    -->
    <groupId>c7586f41-62a9-40a2-9665-aa6c7d456e66</groupId>
    <artifactId>switching-process-api</artifactId>
    <version>1.0.4</version>
    <packaging>mule-application</packaging>

    <name>switching-process-api</name>
    <description>
        Reference implementation of the ARERA-regulated gas switching process
        (cambio venditore) on Mule 4, integrating a Seller's CRM, billing/MDM,
        customer portals and the SII operated by Acquirente Unico.
    </description>

    <properties>
        <!--
          Tagged, not bare. A bare 4.6.0 is resolved by the platform to
          4.6.0:42-java8 and the application runs on Java 8. See the comment
          on <muleVersion> below — this property is the only thing that
          decides the Java version, despite appearances.
        -->
        <app.runtime>4.6.0:42-java17</app.runtime>
        <mule.maven.plugin.version>4.10.1</mule.maven.plugin.version>
        <munit.version>3.3.2</munit.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!--
          Deployment coordinates. Every one of these is overridden from the
          CI environment (see .github/workflows/cd-deploy.yml) so that the
          same artifact is promoted across environments rather than rebuilt.
        -->
        <anypoint.uri>https://anypoint.mulesoft.com</anypoint.uri>
        <ch2.target>Cloudhub-US-East-2</ch2.target>
        <ch2.replicas>1</ch2.replicas>
        <ch2.vcores>0.1</ch2.vcores>
        <deploy.env>dev</deploy.env>
        <deploy.app.name>switching-process-api-dev</deploy.app.name>
        <mule.env>local</mule.env>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.mule.tools.maven</groupId>
                <artifactId>mule-maven-plugin</artifactId>
                <version>${mule.maven.plugin.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <classifier>mule-application</classifier>

                    <!--
                      CloudHub 2.0 deployment.

                      Authentication is by Connected App (client credentials),
                      not a username and password. A Connected App can be
                      scoped to exactly the environments and permissions the
                      pipeline needs, revoked independently of any person, and
                      does not break when someone leaves or enables MFA.
                    -->
                    <cloudhub2Deployment>
                        <uri>${anypoint.uri}</uri>
                        <provider>MC</provider>
                        <environment>${deploy.env}</environment>
                        <target>${ch2.target}</target>
                        <!--
                          This is what selects the Java version, and nothing
                          else does. A bare <muleVersion>4.6.0</muleVersion>
                          is sent without a tag; the platform resolves it to
                          4.6.0:42-java8 — a tag the shared space no longer
                          even offers. Query
                            /runtimefabric/api/organizations/{org}/targets
                          and 4.6.0 lists exactly one tag: 42-java17.

                          The obvious-looking control does NOT work. A
                          <runtime><java>17</java></runtime> block inside
                          deploymentSettings is accepted in full, matches the
                          plugin's own model class, appears in the deployment
                          request — and is ignored. So is an explicit
                          <runtime><version>4.6.0:42-java17</version>. Both
                          were tried against test and both left the app on
                          Java 8. Only the tag here changes it.

                          Nothing warns you. The deployment succeeds, the app
                          reports RUNNING, and the only evidence is
                          runtime.version in the deployment record or a
                          [?:1.8.0_392] frame in a stack trace.
                        -->
                        <muleVersion>${app.runtime}</muleVersion>
                        <applicationName>${deploy.app.name}</applicationName>
                        <connectedAppClientId>${connectedApp.clientId}</connectedAppClientId>
                        <connectedAppClientSecret>${connectedApp.clientSecret}</connectedAppClientSecret>
                        <connectedAppGrantType>client_credentials</connectedAppGrantType>
                        <replicas>${ch2.replicas}</replicas>
                        <vCores>${ch2.vcores}</vCores>

                        <deploymentSettings>
                            <generateDefaultPublicUrl>true</generateDefaultPublicUrl>
                            <updateStrategy>rolling</updateStrategy>
                            <disableAmLogForwarding>false</disableAmLogForwarding>

                            <!--
                              These MUST be nested under http/inbound. The
                              plugin also exposes lastMileSecurity and
                              forwardSslSession at the top level of
                              deploymentSettings, and setting them there is
                              accepted silently — the deployment spec then
                              reports lastMileSecurity: true while http.inbound
                              stays empty, and CloudHub reads the nested value.
                              The result is a healthy application, 1/1
                              replicas started, and a bare 502 from the
                              ingress.

                              Last-mile security matters here beyond making
                              the listener reachable: the inbound listener is
                              HTTPS with its own TLS context, so traffic stays
                              encrypted to the application rather than only to
                              the edge — the appropriate posture for a
                              regulated integration.
                            -->
                            <http>
                                <inbound>
                                    <lastMileSecurity>true</lastMileSecurity>
                                    <!--
                                      forwardSslSession is deliberately absent.
                                      It forwards the client's TLS session
                                      details to the application, and CloudHub
                                      rejects it on a shared space:
                                      "ForwardSslSession is not supported for
                                      the given deployment target". It would
                                      need a private space.

                                      Worth noting it was previously set at the
                                      top level of deploymentSettings, where it
                                      was accepted and silently ignored. Nested
                                      here it is validated — which is how we
                                      learned the top-level values were never
                                      being read.
                                    -->
                                </inbound>
                            </http>

                        </deploymentSettings>

                        <!--
                          Object store persistence is not optional here.
                          The switching correlation store is what reunites
                          an asynchronous distributor outcome with the
                          request that produced it; losing it on replica
                          restart orphans in-flight switches.
                        -->
                        <integrations>
                            <services>
                                <objectStoreV2>
                                    <enabled>true</enabled>
                                </objectStoreV2>
                            </services>
                        </integrations>

                        <properties>
                            <mule.env>${mule.env}</mule.env>
                            <anypoint.platform.client_id>${autodiscovery.clientId}</anypoint.platform.client_id>
                            <!--
                              The API Manager instance this application binds
                              to. Passing -Dapi.id on the command line only
                              sets a Maven property; without forwarding it
                              here the deployed application cannot resolve
                              ${api.id} in the autodiscovery element and dies
                              at startup.
                            -->
                            <api.id>${api.id}</api.id>
                        </properties>

                        <secureProperties>
                            <mule.secure.key>${mule.secure.key}</mule.secure.key>
                            <anypoint.platform.client_secret>${autodiscovery.clientSecret}</anypoint.platform.client_secret>
                        </secureProperties>
                    </cloudhub2Deployment>
                </configuration>
            </plugin>

            <!--
              MUnit. Coverage is enforced, not merely reported: a build that
              drops below the threshold fails. In a regulated integration the
              DataWeave rule modules are the thing an ARERA resolution
              changes, so they are the thing that must stay covered.
            -->
            <plugin>
                <groupId>com.mulesoft.munit.tools</groupId>
                <artifactId>munit-maven-plugin</artifactId>
                <version>${munit.version}</version>
                <executions>
                    <execution>
                        <id>test</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                            <goal>coverage-report</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <runtimeConfiguration>
                        <discoverRuntimes>
                            <product>EE</product>
                        </discoverRuntimes>
                    </runtimeConfiguration>
                    <coverage>
                        <runCoverage>true</runCoverage>
                        <failBuild>true</failBuild>
                        <requiredApplicationCoverage>70</requiredApplicationCoverage>
                        <requiredResourceCoverage>70</requiredResourceCoverage>
                        <requiredFlowCoverage>70</requiredFlowCoverage>
                        <formats>
                            <format>console</format>
                            <format>html</format>
                            <format>json</format>
                        </formats>
                    </coverage>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>org.mule.connectors</groupId>
            <artifactId>mule-http-connector</artifactId>
            <version>1.9.3</version>
            <classifier>mule-plugin</classifier>
        </dependency>
        <dependency>
            <groupId>org.mule.modules</groupId>
            <artifactId>mule-apikit-module</artifactId>
            <version>1.10.2</version>
            <classifier>mule-plugin</classifier>
        </dependency>
        <dependency>
            <groupId>com.mulesoft.connectors</groupId>
            <artifactId>anypoint-mq-connector</artifactId>
            <version>4.0.7</version>
            <classifier>mule-plugin</classifier>
        </dependency>
        <dependency>
            <groupId>com.mulesoft.modules</groupId>
            <artifactId>mule-secure-configuration-property-module</artifactId>
            <version>1.2.7</version>
            <classifier>mule-plugin</classifier>
        </dependency>
        <dependency>
            <groupId>org.mule.modules</groupId>
            <artifactId>mule-validation-module</artifactId>
            <version>2.0.7</version>
            <classifier>mule-plugin</classifier>
        </dependency>
        <dependency>
            <groupId>org.mule.connectors</groupId>
            <artifactId>mule-objectstore-connector</artifactId>
            <version>1.2.2</version>
            <classifier>mule-plugin</classifier>
        </dependency>

        <!--
          API Manager autodiscovery. Registers the deployed application with
          the API instance in API Manager so gateway policies (client-id
          enforcement, rate limiting, JWT validation) are applied to it.
          Without this the app runs but is not governed.
        -->
        <!--
        <dependency>
            <groupId>com.mulesoft.mule.runtime.modules</groupId>
            <artifactId>mule-api-gateway-module</artifactId>
            <version>2.3.1</version>
            <classifier>mule-plugin</classifier>
        </dependency>
        -->

        <!-- ==================== Test scope ==================== -->
        <dependency>
            <groupId>com.mulesoft.munit</groupId>
            <artifactId>munit-runner</artifactId>
            <version>${munit.version}</version>
            <classifier>mule-plugin</classifier>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.mulesoft.munit</groupId>
            <artifactId>munit-tools</artifactId>
            <version>${munit.version}</version>
            <classifier>mule-plugin</classifier>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!--
      ==================== Deployment profiles ====================
      One profile per environment. The artifact is built once, in the CI
      profile, and the same binary is promoted; profiles only vary the
      deployment target and the runtime property set.
    -->
    <profiles>
        <profile>
            <id>dev</id>
            <properties>
                <deploy.env>dev</deploy.env>
                <deploy.app.name>switching-process-api-dev</deploy.app.name>
                <mule.env>dev</mule.env>
                <ch2.replicas>1</ch2.replicas>
                <ch2.vcores>0.1</ch2.vcores>
            </properties>
        </profile>
        <profile>
            <id>test</id>
            <properties>
                <deploy.env>test</deploy.env>
                <deploy.app.name>switching-process-api-test</deploy.app.name>
                <mule.env>test</mule.env>
                <ch2.replicas>1</ch2.replicas>
                <ch2.vcores>0.2</ch2.vcores>
            </properties>
        </profile>
        <profile>
            <id>prod</id>
            <properties>
                <deploy.env>prod</deploy.env>
                <deploy.app.name>switching-process-api</deploy.app.name>
                <mule.env>prod</mule.env>
                <!--
                  Two replicas minimum in production. The 10th of the month is
                  a hard regulatory deadline for the following month's
                  switches; a single-replica restart during that window loses
                  submissions that cannot simply be retried tomorrow.
                -->
                <ch2.replicas>2</ch2.replicas>
                <ch2.vcores>0.5</ch2.vcores>
            </properties>
        </profile>
    </profiles>

    <repositories>
        <repository>
            <id>anypoint-exchange-v3</id>
            <name>Anypoint Exchange</name>
            <url>https://maven.anypoint.mulesoft.com/api/v3/maven</url>
        </repository>
        <repository>
            <id>mulesoft-releases</id>
            <name>MuleSoft Releases Repository</name>
            <url>https://repository.mulesoft.org/releases/</url>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>mulesoft-releases</id>
            <name>MuleSoft Releases Repository</name>
            <url>https://repository.mulesoft.org/releases/</url>
        </pluginRepository>
    </pluginRepositories>

    <!--
      Publishing target for `mvn deploy`. Pushes the built application to
      Exchange so that a release is an immutable, versioned artifact rather
      than whatever happened to be on a laptop.
    -->
    <distributionManagement>
        <repository>
            <id>anypoint-exchange-v3</id>
            <name>Anypoint Exchange</name>
            <url>https://maven.anypoint.mulesoft.com/api/v3/organizations/${anypoint.orgId}/maven</url>
            <layout>default</layout>
        </repository>
    </distributionManagement>

</project>
