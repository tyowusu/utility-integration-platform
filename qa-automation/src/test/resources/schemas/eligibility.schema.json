{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SwitchingEligibility",
  "type": "object",
  "required": ["pdr", "earliestAvailableEffectiveDate", "currentWindow", "availableDates", "regulatoryBasis"],
  "properties": {
    "pdr": {
      "type": "string",
      "pattern": "^[0-9]{14}$"
    },
    "earliestAvailableEffectiveDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-01$"
    },
    "currentWindow": {
      "type": "object",
      "required": ["deadlineDay", "openForNextMonth", "note"],
      "properties": {
        "deadlineDay": {
          "type": "integer",
          "const": 10,
          "description": "Fixed at 10 by Delibera 77/2018/R/com. Pinned with const rather than a range: if the Authority moves the deadline, this schema must fail until someone updates it deliberately."
        },
        "openForNextMonth": { "type": "boolean" },
        "note": { "type": "string" }
      }
    },
    "availableDates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["effectiveDate", "submissionDeadline", "available"],
        "properties": {
          "effectiveDate": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-01$"
          },
          "submissionDeadline": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-10$"
          },
          "available": { "type": "boolean" }
        }
      }
    },
    "regulatoryBasis": {
      "type": "string",
      "minLength": 1
    }
  }
}
