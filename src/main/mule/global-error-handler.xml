<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <!--
      ====================================================================
      CENTRALISED ERROR HANDLING
      ====================================================================
      Uniform error contract across every channel, so the B2C portal, the
      B2B portal and Salesforce all parse one shape.

      Regulated-domain specifics:

        - 422 NOT_ADMISSIBLE carries the regulatory reason. A customer told
          only "request failed" will call the contact centre; one told "the
          switching window for 1 August closed on 10 July" will not.

        - Downstream detail is never returned. SII fault strings can carry
          infrastructure identifiers; they belong in the audit log.

        - Every error response carries correlationId, which is the join key
          to the audit record for a regulator or ombudsman enquiry.
      ====================================================================
    -->

    <error-handler name="global-error-handler">

        <on-error-propagate type="APIKIT:BAD_REQUEST, APIKIT:NOT_ACCEPTABLE, APIKIT:UNSUPPORTED_MEDIA_TYPE"
                            doc:name="400 Bad Request">
            <flow-ref name="log-error" doc:name="Log" />
            <flow-ref name="build-error-response" doc:name="Build response" />
            <set-variable variableName="httpStatus" value="400" />
        </on-error-propagate>

        <!--
          422 rather than 400: the request was syntactically valid but the
          regulation does not permit it. The distinction matters to the
          portals, which retry 400s after correction but must surface a 422
          to the customer as a business outcome.
        -->
        <on-error-propagate type="SWITCHING:NOT_ADMISSIBLE"
                            doc:name="422 Not Admissible">
            <flow-ref name="log-error" doc:name="Log" />
            <flow-ref name="build-error-response" doc:name="Build response" />
            <set-variable variableName="httpStatus" value="422" />
        </on-error-propagate>

        <on-error-propagate type="APIKIT:NOT_FOUND" doc:name="404 Not Found">
            <flow-ref name="log-error" doc:name="Log" />
            <flow-ref name="build-error-response" doc:name="Build response" />
            <set-variable variableName="httpStatus" value="404" />
        </on-error-propagate>

        <on-error-propagate type="APIKIT:METHOD_NOT_ALLOWED" doc:name="405 Method Not Allowed">
            <flow-ref name="log-error" doc:name="Log" />
            <flow-ref name="build-error-response" doc:name="Build response" />
            <set-variable variableName="httpStatus" value="405" />
        </on-error-propagate>

        <on-error-propagate type="HTTP:UNAUTHORIZED" doc:name="401 Unauthorized">
            <flow-ref name="log-error" doc:name="Log" />
            <flow-ref name="build-error-response" doc:name="Build response" />
            <set-variable variableName="httpStatus" value="401" />
        </on-error-propagate>

        <on-error-propagate type="HTTP:FORBIDDEN" doc:name="403 Forbidden">
            <flow-ref name="log-error" doc:name="Log" />
            <flow-ref name="build-error-response" doc:name="Build response" />
            <set-variable variableName="httpStatus" value="403" />
        </on-error-propagate>

        <!--
          SII unavailability is separated from generic failure. Around the
          monthly deadline it is operationally significant: the caller can
          retry before the window closes, and operations needs SII outages
          distinguishable from internal ones in the alerting.
        -->
        <on-error-propagate type="HTTP:TIMEOUT, HTTP:CONNECTIVITY"
                            doc:name="504 Gateway Timeout">
            <flow-ref name="log-error" doc:name="Log" />
            <flow-ref name="build-error-response" doc:name="Build response" />
            <set-variable variableName="httpStatus" value="504" />
        </on-error-propagate>

        <on-error-propagate type="ANY" doc:name="500 Internal Server Error">
            <flow-ref name="log-error" doc:name="Log" />
            <flow-ref name="build-error-response" doc:name="Build response" />
            <set-variable variableName="httpStatus" value="500" />
        </on-error-propagate>

    </error-handler>

    <sub-flow name="log-error">
        <logger level="ERROR" doc:name="Log error detail"
                message='#[%dw 2.0
                    output application/json
                    ---
                    {
                        correlationId: correlationId,
                        errorType: error.errorType.identifier default "UNKNOWN",
                        namespace: error.errorType.namespace default "UNKNOWN",
                        description: error.description default "",
                        detailedDescription: error.detailedDescription default "",
                        flow: flow.name,
                        pdr: vars.switchingRequest.pdr default vars.pdr default null,
                        channel: vars.channel default null
                    }]' />
    </sub-flow>

    <sub-flow name="build-error-response">
        <ee:transform doc:name="Build sanitised error body">
            <ee:message>
                <ee:set-payload><![CDATA[
                    %dw 2.0
                    output application/json
                    ---
                    {
                        error: {
                            code: error.errorType.identifier default "INTERNAL_ERROR",
                            /*
                             * error.description is authored by us at raise-error
                             * time and is safe to surface. detailedDescription may
                             * carry downstream infrastructure detail and is logged
                             * only.
                             */
                            message: error.description default "An unexpected error occurred.",
                            correlationId: correlationId,
                            timestamp: now() as String {format: "yyyy-MM-dd'T'HH:mm:ss'Z'"}
                        }
                    }
                ]]></ee:set-payload>
            </ee:message>
            <ee:variables>
                <ee:set-variable variableName="outboundHeaders"><![CDATA[
                    %dw 2.0
                    output application/java
                    ---
                    { "Content-Type": "application/json" }
                ]]></ee:set-variable>
            </ee:variables>
        </ee:transform>
    </sub-flow>

</mule>
